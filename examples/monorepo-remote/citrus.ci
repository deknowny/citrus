#![citrus(2)]
#![toolchain(["rust-toolchain.toml", ".python-version"])]
#![runner(cmd!("make remote-check"), status = cmd!("make builders-status"))]

/// Fast checks never touch a database: SQLx reads the committed metadata.
#[env(SQLX_OFFLINE = "true")]
profile fast;

/// Slow checks against real services.
profile e2e;

/// PostgreSQL for the e2e checks.
service database {
    start {
        run!("docker compose up -d postgres")?;
    }
    ready {
        std::wait::tcp("localhost:5432", 1m)?;
    }
}

/// The API and its migrations.
#[paths(std::paths::cargo("api") + ["migrations/**"])]
group api {
    check unit {
        run!("cargo test --locked -p api")?;
    }

    /// Against a real database, so only in the slow profile.
    #[profile(e2e)]
    #[needs(database)]
    check database {
        run!("make test-api-db")?;
    }
}

/// The storefront.
#[paths(std::paths::next("@acme/web"))]
group web {
    check unit {
        run!("pnpm --dir . --filter @acme/web run test")?;
    }
}

/// CI scripts: which contract test runs depends on what else changed.
#[paths("scripts/**", "Makefile")]
group pipeline {
    #[when((only(pipeline)))]
    check contract_0 {
        run!("make test-pipeline")?;
    }

    #[when(!(only(pipeline)) && (without(web)))]
    check contract_1 {
        run!("make test-pipeline-api")?;
    }

    #[when(!(only(pipeline)) && !(without(web)))]
    check contract {
        run!("make test-pipeline-all")?;
    }
}
