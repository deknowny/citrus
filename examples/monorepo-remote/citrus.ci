citrus 1

# A Rust and Next.js monorepo whose checks run on shared builders.

project {
  toolchain = ["rust-toolchain.toml", ".python-version"]
}

# Fast checks never touch a database: SQLx reads the committed metadata.
profile fast {
  env {
    SQLX_OFFLINE = "true"
  }
}

# Slow checks against real services.
profile e2e

# PostgreSQL for the e2e checks.
service database = compose.up("postgres") {
  ready = wait.tcp("localhost:5432", timeout: 60s)
}

# The builders run the planned checks and report each one in the runner
# protocol; `status` describes the machines (shown from a snapshot).
runner builders = make("remote-check") {
  status = make("builders-status")
}

# The API and its migrations.
group api {
  paths = crate("api") + ["migrations/**"]
  check unit = cargo.test("api")

  # Against a real database, so only in the slow profile.
  check database = make("test-api-db") {
    profile = e2e
    needs = [database]
  }
}

# The storefront.
group web {
  paths = next("@acme/web")
  check unit = pnpm.test("@acme/web")
}

# CI scripts: which contract test runs depends on what else changed.
group pipeline {
  paths = ["scripts/**", "Makefile"]
  check contract = match changed {
    only(pipeline) => make("test-pipeline")
    without(web) => make("test-pipeline-api")
    _ => make("test-pipeline-all")
  }
}
