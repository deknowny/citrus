citrus 1

# The smallest setup: checks are Make targets.
# `paths` select a check when they change; `reads` only invalidate its
# earlier pass. A pass is reused while both are unchanged.

# API unit tests.
check test-api = make("test-api") {
  paths = ["api/**"]
  reads = ["Cargo.lock"]
}

# Markdown links and spelling.
check lint-docs = make("lint-docs") {
  paths = ["docs/**", "*.md"]
}
