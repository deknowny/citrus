citrus 1

# A pnpm workspace with a Next.js app and a shared component library.

# The shop: the Next.js app and every workspace package it uses.
group shop {
  paths = next("@acme/shop")
  check unit = pnpm.test("@acme/shop")
  check build = pnpm.build("@acme/shop")
}

# Components shared by the apps.
group ui {
  paths = package("@acme/ui")
  check unit = pnpm.test("@acme/ui")
}
