#![citrus(2)]

/// The shop: the Next.js app and every workspace package it uses.
#[paths(std::paths::next("@acme/shop"))]
group shop {
    check unit {
        run!("pnpm --dir . --filter @acme/shop run test")?;
    }

    check build {
        run!("pnpm --dir . --filter @acme/shop run build")?;
    }
}

/// Components shared by the apps.
#[paths(std::paths::package("@acme/ui"))]
group ui {
    check unit {
        run!("pnpm --dir . --filter @acme/ui run test")?;
    }
}
