#![citrus(2)]
#![toolchain("Cargo.lock")]
#![image(dockerfile = "ci/pool.Dockerfile", context = "ci")]

// Citrus checks itself with Citrus: `citrus run` picks what a change needs.

/// The sources every Rust check reads.
const RUST: list<glob> = ["src/**", "tests/**", "Cargo.toml", "Cargo.lock", "build.rs"];

/// Unit and integration tests on throwaway Git repositories, their state in
/// a throwaway Postgres (each repository its own schema). Many tests wait on
/// child processes rather than compute, so more threads than cores keep the
/// run as long as its slowest test.
#[paths("examples/**")]
#[env(RUST_TEST_THREADS = "32")]
check test {
    let run = std::env::var("CITRUS_POOL_RUN").unwrap_or("local");
    let name = "citrus-test-pg-{run}";
    run!("docker rm -f {name}")?;
    run!("docker run -d --name {name} -e POSTGRES_PASSWORD=t -p 127.0.0.1::5432 postgres:17-alpine -c max_connections=1000")?;
    run!("docker exec {name} sh -c 'until pg_isready -U postgres -h 127.0.0.1 -q; do sleep 0.2; done'")?;
    let port = cmd!("docker port {name} 5432").output()?.stdout.trim().split(":").last().unwrap_or("");
    let url = "postgres://postgres:t@127.0.0.1:{port}/postgres?sslmode=disable";
    // On an agent the daemon is the host's: the tests' bind mounts would not
    // reach it, so they see no Docker there.
    let hidden = if std::env::var("CITRUS_POOL_RUN").is_some() { "unix:///nonexistent" } else { "" };
    // Its own target directory: a build beside it would replace the
    // executable the tests' workers start.
    let target = std::env::var("CARGO_TARGET_DIR").unwrap_or("target") + "-test";
    let tests = cmd!("cargo test --locked --bins --test cli").env("CITRUS_TEST_STATE", url).env("CARGO_TARGET_DIR", target).env("DOCKER_HOST", hidden).output()?;
    run!("docker rm -f {name}")?;
    assert tests.code == 0, "{tests.stdout}\n{tests.stderr}";
}

/// The pool against a throwaway Postgres (agents, queue, outputs): only when
/// the pool's code changes, it takes a minute.
#[paths("src/pool.rs", "src/state.rs", "tests/pool.rs")]
#[reads(RUST)]
check pool {
    let run = std::env::var("CITRUS_POOL_RUN").unwrap_or("local");
    let name = "citrus-pool-pg-{run}";
    run!("docker rm -f {name}")?;
    run!("docker run -d --name {name} -e POSTGRES_PASSWORD=t -p 127.0.0.1::5432 postgres:17-alpine -c max_connections=1000")?;
    run!("docker exec {name} sh -c 'until pg_isready -U postgres -h 127.0.0.1 -q; do sleep 0.2; done'")?;
    let port = cmd!("docker port {name} 5432").output()?.stdout.trim().split(":").last().unwrap_or("");
    let url = "postgres://postgres:t@127.0.0.1:{port}/postgres?sslmode=disable";
    // On an agent the daemon is the host's: the tests' bind mounts would not
    // reach it, so they see no Docker there.
    let hidden = if std::env::var("CITRUS_POOL_RUN").is_some() { "unix:///nonexistent" } else { "" };
    // Its own target directory: rebuilding the binary under the `test`
    // check running beside it would delete the executable its workers start.
    let target = std::env::var("CARGO_TARGET_DIR").unwrap_or("target") + "-pool";
    let tests = cmd!("cargo test --locked --test pool").env("CITRUS_TEST_POOL", url).env("CARGO_TARGET_DIR", target).env("DOCKER_HOST", hidden).output()?;
    run!("docker rm -f {name}")?;
    assert tests.code == 0, "{tests.stdout}\n{tests.stderr}";
}

/// rustfmt and clippy with warnings as errors.
check lint {
    run!("cargo fmt --all --check")?;
    run!("cargo clippy --locked --all-targets -- -D warnings")?;
    run!("cargo run --quiet --locked -- fmt --check")?;
}

/// Relative links in Markdown point at existing files.
#[paths("*.md", "docs/**", "skills/**", "examples/**")]
check docs {
    std::docs::check_links("**/*.md")?;
}

/// This repository's own configuration is valid.
#[paths("citrus.ci")]
#[reads(RUST)]
check doctor {
    run!("cargo run --quiet -- doctor --text")?;
}

/// The build agents and launchers take: published to the pool under its
/// commit (`citrus pool publish` refuses a build of a changed tree). On a
/// pool agent that is the Linux build; run locally, this machine's.
#[paths(RUST)]
check build {
    run!("cargo build --quiet --locked --profile fast")?;
    let target = std::env::var("CARGO_TARGET_DIR").unwrap_or("target");
    run!("{target}/fast/citrus pool publish {target}/fast/citrus")?;
}

/// Run on a Mac, also the static Linux build the pool agents and production
/// tools take (cargo-zigbuild, its own target directory so it runs beside
/// `build`): no builder compiles a new Citrus itself. On Linux `build`
/// already published it.
#[paths(RUST)]
check build_linux {
    if std::env::platform() != "linux-x86_64" {
        let musl = "x86_64-unknown-linux-musl";
        run!("cargo zigbuild --quiet --locked --profile fast --target {musl} --target-dir target/cross")?;
        run!("citrus pool publish --platform linux-x86_64 target/cross/{musl}/fast/citrus")?;
    };
}

/// Format the code.
task fmt {
    run!("cargo fmt --all")?;
}

/// GitHub: tags and the binaries the release workflow publishes.
environment github_repo;

/// `citrus release start github --version X.Y.Z --approve`: tag a proven main
/// commit; the release workflow publishes the binaries and SHA256SUMS.
#[environment(github_repo)]
release github {
    /// Only a commit that is on origin/main, with its version and notes.
    step main(r: Release) {
        run!("git fetch --quiet origin main")?;
        run!("git merge-base --is-ancestor HEAD origin/main")
            .context("{r.commit} is not on origin/main")?;
        let manifest = std::fs::read("Cargo.toml")?;
        assert manifest.contains("version = \"{r.version}\""), "Cargo.toml is not at {r.version}";
        let notes = std::fs::read("CHANGELOG.md")?;
        assert notes.contains("## {r.version} "), "CHANGELOG.md has no section for {r.version}";
    }

    #[production]
    #[recover(push_tag)]
    step tag(r: Release) {
        run!("git tag -a v{r.version} -m 'Citrus v{r.version}'")?;
        push_tag(r)?;
    }

    step binaries(r: Release) {
        let base = "https://github.com/deknowny/citrus/releases/download";
        std::wait::http("{base}/v{r.version}/SHA256SUMS", 30m)?;
    }
}

/// The tag may exist already: only push it.
fn push_tag(r: Release) -> Result<()> {
    run!("git push --quiet origin v{r.version}")
}
