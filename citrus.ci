citrus 1

# Citrus checks itself with Citrus: `citrus run` picks what a change needs.

project {
  toolchain = ["Cargo.lock"]
}

let rust = ["src/**", "tests/**", "Cargo.toml", "Cargo.lock", "build.rs"]

# Unit and integration tests on throwaway Git repositories.
check test = cargo.test() {
  paths = rust + ["examples/**"]
}

# rustfmt and clippy with warnings as errors.
check lint = [cargo.fmt(check: true), cargo.clippy(deny: "warnings")] {
  paths = rust + ["rustfmt.toml"]
}

# Relative links in Markdown point at existing files.
check docs = links.check("**/*.md") {
  paths = ["*.md", "docs/**", "skills/**", "examples/**"]
}

# This repository's own configuration is valid and formatted.
check doctor = [cargo.run("doctor", "--text"), cargo.run("fmt", "--check", "--text")] {
  paths = ["citrus.ci"]
  reads = rust
}

# Format the code.
task fmt = cargo.fmt()

# `citrus release start github --version X.Y.Z --approve`: tag a proven main
# commit; the release workflow publishes the binaries and SHA256SUMS.
release github {
  environment = github

  # Only a commit that is on origin/main, with its version and notes.
  step main = [
    run("git", "fetch", "--quiet", "origin", "main"),
    run("git", "merge-base", "--is-ancestor", "HEAD", "origin/main"),
    run("grep", "-q", "^version = \"{version}\"", "Cargo.toml"),
    run("grep", "-q", "^## {version} ", "CHANGELOG.md"),
  ]

  step tag = [
    run("git", "tag", "-a", "v{version}", "-m", "Citrus v{version}"),
    run("git", "push", "--quiet", "origin", "v{version}"),
  ] {
    production = true
    # The tag may exist already: only push it.
    recover = run("git", "push", "--quiet", "origin", "v{version}")
  }

  step binaries = wait.http("https://github.com/deknowny/citrus/releases/download/v{version}/SHA256SUMS", timeout: 30m)
}
